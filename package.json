{
  "name": "the-japan-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run data:sync && vite",
    "build": "npm run typecheck && npm run data:sync && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:process": "tsx scripts/process-data.ts",
    "data:sync": "tsx scripts/sync-data.ts"
  },
  "devDependencies": {
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "^22.0.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "mapshaper": "0.7.88",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "maplibre-gl": "6.14.0"
  }
}
